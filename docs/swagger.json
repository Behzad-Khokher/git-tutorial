    "swagger": "2.0",
    "info": {
        "description": "This is the endpoint documentation for the Dittofi App ID 1276.",
        "title": "Dittofi API - My Super Powerful App (AppID: 1276)",
        "termsOfService": "http://swagger.io/terms/",
        "contact": {
            "name": "Dittofi Support Team",
